# Copiar a .env.local y completar. Nunca commitear .env.local.

# --- Supabase ---------------------------------------------------------
# Local: `npx supabase start` imprime la URL y las claves.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (service role): SOLO servidor. Habilita avisos, priorización por IA y la API de Migue.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IA (Claude) ------------------------------------------------------
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
# low | medium | high | xhigh | max
IA_ESFUERZO=medium

# --- Email (Resend) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_REMITENTE="Tramita Capital <tramites@smt.gob.ar>"

# --- Migue (bot municipal) --------------------------------------------
# Token que Migue envía para consultar /api/migue
MIGUE_API_TOKEN=
# Endpoint de Migue para que enviemos avisos a los agentes (opcional)
MIGUE_WEBHOOK_URL=
MIGUE_WEBHOOK_TOKEN=
